{
  "manifest_version": 3,
  "name": "Sarideo \u2014 Flow",
  "version": "1.1.0",
  "description": "Flow'da yasalgan rasmlarni Sarideo loyihasiga yuboradi, va Sarideo navbatidagi promptlarni Flow'da bajaradi.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://flow.google/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_popup": "options.html",
    "default_title": "Sarideo \u2014 Flow"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/*",
        "https://flow.google/*"
      ],
      "js": [
        "flow-dom.js",
        "flow.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
