# ─── Required ────────────────────────────────────────────────────────────────
# Claude writes the script, image prompts, subtitle breaks and YouTube metadata.
ANTHROPIC_API_KEY=sk-ant-...

# ─── Image generation (pick one; all three adapters ship) ────────────────────
# gemini | fal | openai
IMAGE_PROVIDER=gemini

# Gemini — best hero/character consistency from reference photos
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# fal.ai — Flux Kontext, strong multi-reference character preservation
FAL_KEY=
# FAL_IMAGE_MODEL=fal-ai/flux-pro/kontext/max/multi
# FAL_TEXT2IMG_MODEL=fal-ai/flux/dev

# OpenAI — gpt-image-1
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1

# ─── Voice-over (pick one) ───────────────────────────────────────────────────
# elevenlabs | openai | gemini   (or upload your own audio in the UI)
TTS_PROVIDER=elevenlabs

# ElevenLabs — the only provider that returns word timings, so subtitles land
# exactly on the syllable without a second API call.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_MODEL=eleven_multilingual_v2

# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Kore

# ─── Subtitle timing ─────────────────────────────────────────────────────────
# auto      -> ElevenLabs timings if available, else Whisper, else an estimate
# whisper   -> always transcribe the rendered audio (needs OPENAI_API_KEY)
# estimate  -> no extra API call; timings inferred from word lengths
ALIGN_PROVIDER=auto
# OPENAI_API_KEY is also what makes "upload my own voice-over" work.

# ─── Storage ─────────────────────────────────────────────────────────────────
# local    -> files live in the container (lost on every Railway redeploy)
# supabase -> uploaded to a public bucket, links survive redeploys
STORAGE_BACKEND=supabase
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=videos

# ─── Rendering (optional tuning) ─────────────────────────────────────────────
# FPS=30
# VIDEO_CRF=20                 # lower = better quality, bigger file
# VIDEO_PRESET=medium          # ultrafast … veryslow
# TRANSITION_SECONDS=0.6
# SECONDS_PER_SCENE=6.5        # drives how many scenes a duration turns into
# MAX_SCENES=90
# SUBTITLE_FONT=DejaVu Sans
# MUSIC_VOLUME=0.10
# IMAGE_CONCURRENCY=3
# TTS_CONCURRENCY=3
# MAX_CONCURRENT_JOBS=1        # raise only if the container has RAM to spare
# DATA_DIR=/data
