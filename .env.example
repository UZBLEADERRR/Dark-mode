# ═══════════════════════════════════════════════════════════════════════════
#  MINIMUM SETUP — one Gemini key runs everything
# ═══════════════════════════════════════════════════════════════════════════
# Script, image prompts, subtitle breaks, YouTube metadata, scene images and
# the voice-over all come from this single key.
GEMINI_API_KEY=AIza...

# ═══════════════════════════════════════════════════════════════════════════
#  Optional — everything below has a working default
# ═══════════════════════════════════════════════════════════════════════════

# ─── Which model writes the script ──────────────────────────────────────────
# auto (default) -> Claude when ANTHROPIC_API_KEY is set, otherwise Gemini
# LLM_PROVIDER=auto
# ANTHROPIC_API_KEY=sk-ant-...        # only if you want Claude to write scripts
# LLM_MODEL=claude-opus-5
# GEMINI_TEXT_MODEL=gemini-2.5-pro
# GEMINI_TEXT_FALLBACK=gemini-2.5-flash

# ─── Scene images ───────────────────────────────────────────────────────────
# gemini | fal | openai
IMAGE_PROVIDER=gemini
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# fal.ai — Flux Kontext, strong multi-reference character preservation
# FAL_KEY=
# FAL_IMAGE_MODEL=fal-ai/flux-pro/kontext/max/multi
# FAL_TEXT2IMG_MODEL=fal-ai/flux/dev

# OpenAI — gpt-image-1
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1

# ─── Voice-over ─────────────────────────────────────────────────────────────
# gemini | elevenlabs | openai   (or upload your own audio in the UI)
TTS_PROVIDER=gemini
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Kore

# ElevenLabs is the only provider that returns word timings, so subtitles land
# on the syllable without a second API call. Worth adding if captions matter.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_MODEL=eleven_multilingual_v2

# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy

# ─── Subtitle timing ────────────────────────────────────────────────────────
# auto     -> ElevenLabs timings if available, else Whisper, else an estimate
# whisper  -> always transcribe the rendered audio (needs OPENAI_API_KEY)
# estimate -> no extra API call; timings inferred from word lengths
# ALIGN_PROVIDER=auto
#
# OPENAI_API_KEY is also what makes "upload my own voice-over" work — that
# feature needs a transcription to know where each word falls.

# ─── Storage ────────────────────────────────────────────────────────────────
# local (default) -> renders stay in the container; download them when done
# supabase        -> also uploaded to a public bucket, links survive redeploys
#
# Hero photos and music are always kept in the SQLite database under DATA_DIR,
# so a single Railway volume mounted at /data preserves the whole library.
# STORAGE_BACKEND=local
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=videos

# ─── Rendering ──────────────────────────────────────────────────────────────
# FPS=30
# VIDEO_CRF=20                 # lower = better quality, bigger file
# VIDEO_PRESET=medium          # ultrafast … veryslow
# TRANSITION_SECONDS=0.6
# SECONDS_PER_SCENE=6.5        # drives how many scenes a duration turns into
# MAX_SCENES=90
# SUBTITLE_FONT=DejaVu Sans
# MUSIC_VOLUME=0.10
# IMAGE_CONCURRENCY=3
# TTS_CONCURRENCY=3
# Voice calls per minute, per provider. Gemini's free tier sells voice by the
# minute, so it is paced by default; ElevenLabs and OpenAI limit how many calls
# run at once rather than how many start, so they are not paced at all.
# TTS_RATE_LIMIT_GEMINI=10
# TTS_RATE_LIMIT_ELEVENLABS=0  # 0 = no pacing
# TTS_RATE_LIMIT_OPENAI=0
# TTS_RATE_LIMIT=10            # applies to every provider, overriding the above
# TTS_RATE_PATIENCE=900        # how long one line may spend queueing before giving up
# TTS_TIMEOUT=90               # one voice call
# TTS_DEADLINE=180             # all of its retries together — raise on a slow link
# IMAGE_TIMEOUT=150
# IMAGE_DEADLINE=330           # past this the scene gets a placeholder, not a hang
# MAX_CONCURRENT_JOBS=1        # raise only if the container has RAM to spare
# DATA_DIR=/data

# Postgres for the hero library only. Railway sets this for you when you add a
# Postgres service; without it heroes live in SQLite and a deploy wipes them.
# Everything else — jobs, music, renders — stays local either way.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
