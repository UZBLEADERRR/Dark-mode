{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "flowagent/Dockerfile"
  },
  "deploy": {
    "startCommand": "sh -c 'mkdir -p \"$FLOW_OUTPUT_DIR\" && exec uvicorn flow_server.api:app --host 0.0.0.0 --port ${PORT:-8001} --no-access-log'",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
